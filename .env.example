# ===== LLM（对话）=====
# 支持任何兼容 OpenAI 接口的服务（智谱 BigModel / OpenAI / 等）
# 使用项目专属前缀，避免系统或其他 AI 工具的同名变量覆盖 HireMS 配置。
HIREMS_LLM_API_KEY=your-llm-api-key
HIREMS_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
HIREMS_LLM_MODEL=glm-4.7-flashx
HIREMS_LLM_TEMPERATURE=0.0
# 兼容旧变量：LLM_API_KEY / LLM_BASE_URL / LLM_MODEL / LLM_TEMPERATURE

# ===== Embedding（向量化）=====
# 嵌入后端：openai（默认，OpenAI 兼容 API）/ local（本地 sentence-transformers 轻量模型）
EMBEDDING_PROVIDER=openai

# --- openai 后端配置 ---
# 智谱 embedding-3 默认 2048 维（可设为 256~2048）
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=2048

# --- local 后端配置（EMBEDDING_PROVIDER=local 时生效，无需任何 API Key）---
# 先安装可选依赖：pip install -r requirements-local.txt
# 默认模型 BAAI/bge-small-zh-v1.5（512 维 / 约 95MB / 中文友好，CPU 可跑）
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 运行设备：cpu / cuda / mps
# EMBEDDING_DEVICE=cpu
# 模型本地缓存目录；首次下载后的后续启动可直接离线复用
# LOCAL_EMBEDDING_CACHE_DIR=./models/huggingface
# 默认只读取已下载的模型文件，防止内网或离线环境触发网络重试
# LOCAL_EMBEDDING_OFFLINE=true
# bge 中文系列推荐的检索查询前缀（留空不加）
# EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
# 注意：local 后端忽略 EMBEDDING_DIMENSIONS（维度由模型决定）；切换模型后需清空重建向量库

# ===== 向后兼容：若 LLM_*/EMBEDDING_* 未设置，则回退到下面统一配置 =====
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 向量数据库 =====
# 后端选择：chroma（默认，本地持久化）/ milvus（Milvus/Zilliz Cloud）
VECTOR_DB=chroma
CHROMA_PERSIST_DIR=./chroma_db

# ===== Milvus / Zilliz Cloud（VECTOR_DB=milvus 时生效）=====
# 可直接提供完整 URI，或提供 HOST + PORT 自动拼接
# MILVUS_URI=https://your-instance.zillizcloud.com
MILVUS_HOST=https://your-instance.serverless.cloud.zilliz.com.cn
MILVUS_PORT=80
MILVUS_TOKEN=your-milvus-token
MILVUS_COLLECTION=resume_screening
# 索引类型：AUTOINDEX / IVF_FLAT / HNSW 等
INDEX=AUTOINDEX

# ===== 服务 / 跨域 =====
# 允许的前端来源（逗号分隔），留空则允许所有来源
SERVER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 缓存 / 日志 =====
CACHE_DIR=./cache
LOG_LEVEL=INFO

# ===== 飞书邮箱简历抓取（推荐使用企业邮箱 IMAP；不将密码写进 UI） =====
# 飞书邮箱需先由管理员开通 IMAP/第三方客户端访问。可填企业 IMAP 地址。
MAIL_IMAP_HOST=imap.feishu.cn
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=hr@example.com
MAIL_IMAP_PASSWORD=replace-with-app-password
MAIL_IMAP_FOLDER=INBOX
# 逗号分隔；留空即扫描所有含附件邮件
MAIL_SUBJECT_KEYWORDS=简历,应聘,求职
MAIL_LOOKBACK_DAYS=7

# ===== 飞书多维表格 =====
# 自建应用凭证：仅放在 .env，切勿提交或粘贴到 Web UI。
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_BITABLE_APP_TOKEN=app_xxx
FEISHU_BITABLE_TABLE_ID=tbl_xxx
# 导出记录的最低分；低于此分仍会在本地待复核列表中保留。
FEISHU_EXPORT_MIN_SCORE=0.70

# ===== 飞书消息卡片 / 面试日历 / 自动提醒 =====
# HR 接收人使用飞书 open_id，多个接收人以逗号分隔。
FEISHU_HR_RECEIVER_IDS=ou_xxx,ou_yyy
# 写入面试日程的共享日历 ID；应用须拥有 writer / owner 权限。
FEISHU_CALENDAR_ID=feishu.cn_xxx@group.calendar.feishu.cn
# 可选：面试官 open_id 到其可读日历 ID 的 JSON，用于排期前自动查忙闲。
# FEISHU_INTERVIEWER_CALENDAR_MAP={"ou_xxx":"feishu.cn_xxx@group.calendar.feishu.cn"}
FEISHU_INTERVIEWER_CALENDAR_MAP={}
# 卡片回传校验 Token（在飞书“事件与回调”后台配置）
FEISHU_CALLBACK_TOKEN=replace-with-callback-token
# 供卡片“查看”按钮跳转的公网地址；本地开发可留空。
FEISHU_PUBLIC_BASE_URL=https://hirems.example.com
NOTIFY_OVERDUE_HOURS=48
